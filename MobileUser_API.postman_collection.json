{
  "info": {
    "name": "Mobile User - Complete API Collection",
    "description": "All 22 APIs - Registration, Login, Profile, Forgot Password, Profile Image Upload, Client Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://viralstatus-backend.serveminecraft.net/api/mobile/user"
    },
    {
      "key": "CLIENT_BASE_URL",
      "value": "https://viralstatus-backend.serveminecraft.net/api/auth/client"
    },
    {
      "key": "clientId",
      "value": "CLI-UOVNVD"
    },
    {
      "key": "JWT_TOKEN",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Client Auth",
      "description": "Client register/login - CLI-XXXXXX auto generate hota hai",
      "item": [
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{CLIENT_BASE_URL}}/register",
              "host": ["{{CLIENT_BASE_URL}}"],
              "path": ["register"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"company@example.com\",\n  \"password\": \"Company@123\",\n  \"businessName\": \"My Company\",\n  \"contactPerson\": \"Anil Kumar\",\n  \"phone\": \"+919876543210\"\n}"
            }
          }
        },
        {
          "name": "Login Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{CLIENT_BASE_URL}}/login",
              "host": ["{{CLIENT_BASE_URL}}"],
              "path": ["login"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"company@example.com\",\n  \"password\": \"Company@123\"\n}"
            }
          }
        },
        {
          "name": "Get Client Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }],
            "url": {
              "raw": "{{CLIENT_BASE_URL}}/me",
              "host": ["{{CLIENT_BASE_URL}}"],
              "path": ["me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Registration Flow",
      "description": "Step 0 → Step 1 Email OTP → Step 2 Mobile OTP → Step 3 Profile Complete → JWT Token",
      "item": [
        {
          "name": "Step 1 - Send Email OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/register/step1",
              "host": ["{{BASE_URL}}"],
              "path": ["register", "step1"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"User@1234\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Step 1 Verify - Verify Email OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/register/step1/verify",
              "host": ["{{BASE_URL}}"],
              "path": ["register", "step1", "verify"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Step 2 - Send Mobile OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/register/step2",
              "host": ["{{BASE_URL}}"],
              "path": ["register", "step2"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"mobile\": \"+919876543210\",\n  \"otpMethod\": \"gupshup\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Step 2 Verify - Verify Mobile OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/register/step2/verify",
              "host": ["{{BASE_URL}}"],
              "path": ["register", "step2", "verify"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"mobile\": \"+919876543210\",\n  \"otp\": \"654321\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Step 3 - Complete Profile (JWT Token Milta Hai)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/register/step3",
              "host": ["{{BASE_URL}}"],
              "path": ["register", "step3"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"clientId\": \"{{clientId}}\",\n  \"name\": \"Anil Kumar\",\n  \"city\": \"Delhi\",\n  \"pincode\": \"110001\",\n  \"businessName\": \"My Business\",\n  \"gender\": \"male\",\n  \"ageRange\": \"25-30\",\n  \"businessInterests\": [\"technology\", \"finance\"],\n  \"occupation\": \"Software Engineer\",\n  \"highestQualification\": \"B.Tech\",\n  \"fieldOfStudy\": \"Computer Science\",\n  \"skills\": [\"JavaScript\", \"Node.js\"],\n  \"socialMedia\": {\n    \"instagram\": { \"handle\": \"@anil_kumar\", \"followersCount\": \"1000\" },\n    \"youtube\": { \"channelUrl\": \"https://youtube.com/@anil\", \"subscribers\": \"500\" }\n  }\n}"
            }
          }
        },
        {
          "name": "Resend Email OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/register/resend-email-otp",
              "host": ["{{BASE_URL}}"],
              "path": ["register", "resend-email-otp"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Resend Mobile OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/register/resend-mobile-otp",
              "host": ["{{BASE_URL}}"],
              "path": ["register", "resend-mobile-otp"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"mobile\": \"+919876543210\",\n  \"otpMethod\": \"gupshup\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. User Login",
      "description": "Email/Password login, Google, Firebase login flows",
      "item": [
        {
          "name": "User Login - Email and Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/login",
              "host": ["{{BASE_URL}}"],
              "path": ["login"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"User@1234\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Google Login or Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/register/google",
              "host": ["{{BASE_URL}}"],
              "path": ["register", "google"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"credential\": \"<Google ID Token>\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Firebase Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/register/firebase",
              "host": ["{{BASE_URL}}"],
              "path": ["register", "firebase"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"idToken\": \"<Firebase ID Token>\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Firebase Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/login/firebase",
              "host": ["{{BASE_URL}}"],
              "path": ["login", "firebase"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"idToken\": \"<Firebase ID Token>\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Check Email Registration Status",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/check-email",
              "host": ["{{BASE_URL}}"],
              "path": ["check-email"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. User Profile",
      "description": "Profile get, update - JWT Token required",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/profile",
              "host": ["{{BASE_URL}}"],
              "path": ["profile"]
            }
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/profile",
              "host": ["{{BASE_URL}}"],
              "path": ["profile"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Anil Kumar Singh\",\n  \"city\": \"Mumbai\",\n  \"pincode\": \"400001\",\n  \"businessName\": \"My Updated Business\",\n  \"gender\": \"male\",\n  \"ageRange\": \"25-30\",\n  \"businessInterests\": [\"technology\", \"marketing\"],\n  \"occupation\": \"Software Engineer\",\n  \"highestQualification\": \"M.Tech\",\n  \"fieldOfStudy\": \"Computer Science\",\n  \"skills\": [\"JavaScript\", \"Node.js\", \"React\"],\n  \"socialMedia\": {\n    \"instagram\": { \"handle\": \"@anil_updated\", \"followersCount\": \"2000\" },\n    \"youtube\": { \"channelUrl\": \"https://youtube.com/@anil_updated\", \"subscribers\": \"1000\" }\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Profile Image Upload (R2)",
      "description": "Step 1: Get presigned URL → Step 2: PUT image to R2 → Step 3: Confirm key in DB",
      "item": [
        {
          "name": "Step 1 - Get Profile Image Upload URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/profile/image/upload-url",
              "host": ["{{BASE_URL}}"],
              "path": ["profile", "image", "upload-url"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"fileType\": \"image/jpeg\"\n}"
            }
          }
        },
        {
          "name": "Step 2 - Upload Image to R2 (PUT Request)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "image/jpeg" }
            ],
            "url": {
              "raw": "<uploadUrl from Step 1 response>",
              "host": ["<uploadUrl from Step 1 response>"]
            },
            "body": {
              "mode": "file",
              "file": {}
            }
          }
        },
        {
          "name": "Step 3 - Confirm Profile Image After Upload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/profile/image/confirm",
              "host": ["{{BASE_URL}}"],
              "path": ["profile", "image", "confirm"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"key\": \"profile-images/USER_ID/1234567890.jpeg\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "6. Forgot Password",
      "description": "Send OTP → Verify OTP → Reset Password. Resend OTP bhi available hai",
      "item": [
        {
          "name": "Forgot Password - Send Reset OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/forgot-password",
              "host": ["{{BASE_URL}}"],
              "path": ["forgot-password"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password - Verify Reset OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/forgot-password/verify-otp",
              "host": ["{{BASE_URL}}"],
              "path": ["forgot-password", "verify-otp"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password - Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/forgot-password/reset",
              "host": ["{{BASE_URL}}"],
              "path": ["forgot-password", "reset"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"newPassword\": \"NewPass@5678\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password - Resend Reset OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/forgot-password/resend-otp",
              "host": ["{{BASE_URL}}"],
              "path": ["forgot-password", "resend-otp"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        }
      ]
    }
  ]
}
